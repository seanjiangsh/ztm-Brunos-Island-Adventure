<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Global%20Stylesheet.uss?fileID=7433441132597879392&amp;guid=726531e8596f4a14f93f5bdb695f77f0&amp;type=3#Global Stylesheet" />
    <engine:VisualElement name="main-menu-container" class="center" style="flex-grow: 1; display: none;">
        <engine:VisualElement name="box" class="primary-container main-text" style="position: relative;">
            <engine:Label text="Bruno&apos;s Island Adventure" class="base-text" />
            <engine:VisualElement name="buttons" style="flex-grow: 1; position: absolute; left: 0; bottom: -50px; width: 100%; flex-direction: row; justify-content: center; flex-shrink: initial;">
                <engine:Button text="Start" name="start-button" class="menu-button" />
                <engine:Button text="Button" name="temp-button" class="menu-button" />
            </engine:VisualElement>
            <engine:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Game%20Assets/Sprites/Bombs.png?fileID=2800000&amp;guid=4420e8d6e00706f4f84dad51b2169cb1&amp;type=3#Bombs&quot;); width: 332px; height: 174px; position: absolute; top: -120px; left: 234px;" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="player-info-container" style="flex-grow: 1; position: absolute; top: 50px; left: 50px; flex-direction: row; display: none;">
        <engine:VisualElement class="stat-container">
            <engine:Label text="Health" class="stat-name" />
            <engine:Label text="000&#10;" name="health-label" class="stat-value" />
        </engine:VisualElement>
        <engine:VisualElement class="stat-container">
            <engine:Label text="Potions" class="stat-name" />
            <engine:Label text="000&#10;" name="potions-label" class="stat-value" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="dialog-container" style="flex-grow: 1; position: absolute; left: 0; bottom: 0; width: 100%; padding-top: 60px; padding-right: 60px; padding-bottom: 60px; padding-left: 60px; display: none;">
        <engine:VisualElement class="primary-container" style="flex-grow: 0; flex-wrap: wrap; display: flex;">
            <engine:Label text="Label" name="dialog-text" class="base-text" style="font-size: 16px; -unity-font-style: normal; color: rgb(118, 62, 62); -unity-text-align: upper-left; -unity-text-outline-width: 0; padding-top: 4px; padding-right: 2px; padding-bottom: 4px; padding-left: 1px; flex-wrap: nowrap; white-space: normal;" />
            <engine:Button text="Next" name="dialog-next-button" class="menu-button" style="position: absolute; right: 50px; bottom: -40px; display: none; font-size: 20px; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;" />
            <engine:VisualElement name="choices-group" style="flex-grow: 1; flex-direction: row; justify-content: flex-end; align-self: auto; position: absolute; right: 50px; bottom: -50px; display: none;">
                <engine:Button text="No" name="no-button" class="menu-button" />
                <engine:Button text="Yes" name="yes-button" class="menu-button" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="quest-item-container" style="flex-grow: 1; width: 100%; height: 100%; align-items: center; justify-content: center; display: none; align-self: center; align-content: center; max-width: initial; max-height: 50%;">
        <engine:VisualElement class="primary-container" style="flex-grow: 0; width: auto; height: auto; align-items: center; justify-content: center;">
            <engine:VisualElement style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Game%20Assets/Sprites/Paper%20BG.png?fileID=2800000&amp;guid=b1aa48f59209ca54f8ad1e5966d3e81d&amp;type=3#Paper BG&quot;); height: auto; width: auto; align-items: center; justify-content: center;">
                <engine:VisualElement name="VisualElement" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Game%20Assets/Sprites/Quest%20Item%20Large.png?fileID=2800000&amp;guid=44d1dd07413f62049b0e1c783060a46b&amp;type=3#Quest Item Large&quot;); width: 250px; height: 500px;" />
            </engine:VisualElement>
            <engine:Label text="Label" name="quest-item-label" class="base-text" style="font-size: 40px; margin-top: 40px;" />
            <engine:Button text="Claim" class="menu-button" style="position: absolute; bottom: -59px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
